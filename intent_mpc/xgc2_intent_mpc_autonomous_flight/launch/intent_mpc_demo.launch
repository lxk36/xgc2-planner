<launch>
	<rosparam file="$(find xgc2_cerlab_tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/fake_detector_param.yaml" />
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/flight_base.yaml" ns="xgc2_intent_mpc_autonomous_flight"/>
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/planner_param.yaml" />
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/mapping_param.yaml" ns="/dynamic_map" />
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/dynamic_detector_param.yaml" ns="/xgc2_cerlab_onboard_detector" />
	<rosparam file="$(find xgc2_intent_mpc_autonomous_flight)/cfg/mpc_navigation/predictor_param.yaml" ns="/xgc2_intent_mpc_dynamic_predictor" />

	<node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />
	<node pkg="xgc2_intent_mpc_autonomous_flight" type="mpc_navigation_node" name="mpc_navigation_node" output="screen" />
	<!-- <node pkg="xgc2_cerlab_onboard_detector" type="yolo_detector_node.py" name="yolo_detector_node" output="screen" /> -->
	<include file="$(find xgc2_cerlab_remote_control)/launch/mpc_navigation_rviz.launch" />
</launch>