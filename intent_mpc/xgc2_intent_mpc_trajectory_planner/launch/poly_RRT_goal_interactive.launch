<launch>
	<rosparam>/use_sim_time: 0</rosparam>
	<!-- planner -->
	<rosparam file="$(find xgc2_intent_mpc_trajectory_planner)/cfg/planner_interactive.yaml" />
	<node pkg="xgc2_intent_mpc_trajectory_planner" type="poly_RRT_goal_node" name="poly_RRT_goal_node" output="screen" />

	<!-- map -->
	<arg name="map_location" default="$(find xgc2_intent_mpc_trajectory_planner)/map/box.bt"/>
	<node pkg="octomap_server" type="octomap_server_node" name="octomap_server_node" args="$(arg map_location)" output="log" />
	<node name="rviz" pkg="rviz" type="rviz" args="-d $(find xgc2_intent_mpc_trajectory_planner)/rviz/poly_interactive.rviz"/>
</launch>