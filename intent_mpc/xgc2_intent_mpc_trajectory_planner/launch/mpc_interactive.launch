<launch>
	<rosparam file="$(find xgc2_intent_mpc_trajectory_planner)/cfg/mpc_interactive/polyTraj_param.yaml"/>
	<rosparam file="$(find xgc2_intent_mpc_trajectory_planner)/cfg/mpc_interactive/mpc_param.yaml" ns="/mpc_planner"/>
	<rosparam file="$(find xgc2_intent_mpc_trajectory_planner)/cfg/mpc_interactive/occupancy_map.yaml" ns="/occupancy_map"/>
	<rosparam file="$(find xgc2_intent_mpc_trajectory_planner)/cfg/mpc_interactive/obstacle_test_param.yaml" ns="/obstacle_generator"/>
	<node pkg="xgc2_intent_mpc_trajectory_planner" type="mpc_node" name="mpc_node" output="screen" />
	<node name="rviz" pkg="rviz" type="rviz" args="-d $(find xgc2_intent_mpc_trajectory_planner)/rviz/mpc_interactive.rviz"/>
</launch>