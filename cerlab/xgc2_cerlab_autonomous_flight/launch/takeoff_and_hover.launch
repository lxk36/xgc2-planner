<launch>
	<rosparam file="$(find xgc2_cerlab_tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node"  output="screen" />

	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/takeoff_and_hover/flight_base.yaml" ns="xgc2_cerlab_autonomous_flight"/>
	<node pkg="xgc2_cerlab_autonomous_flight" type="takeoff_and_hover_node" name="takeoff_and_hover_node" output="screen" />
</launch>