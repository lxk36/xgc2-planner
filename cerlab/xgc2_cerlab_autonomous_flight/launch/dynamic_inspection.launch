<launch>
	<rosparam file="$(find xgc2_cerlab_tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />

	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/fake_detector_param.yaml" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/flight_base.yaml" ns="xgc2_cerlab_autonomous_flight"/>
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/planner_param.yaml" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/dynamic_detector_param.yaml" ns="/xgc2_cerlab_onboard_detector" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/mapping_param.yaml" ns="/dynamic_map" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_inspection/inspection_param.yaml" ns="/xgc2_cerlab_autonomous_flight"/>

	<node pkg="xgc2_cerlab_autonomous_flight" type="throttle_topics.sh" name="throttle_topics" />
	<node pkg="xgc2_cerlab_autonomous_flight" type="dynamic_inspection_node" name="dynamic_inspection_node" output="screen" />
</launch>