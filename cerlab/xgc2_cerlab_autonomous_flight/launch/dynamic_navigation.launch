<launch>
	<rosparam file="$(find xgc2_cerlab_tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />
	<!-- <node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" /> -->

	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/fake_detector_param.yaml" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/flight_base.yaml" ns="xgc2_cerlab_autonomous_flight"/>
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/planner_param.yaml" />
	<!-- <rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/mapping_param.yaml" ns="/occupancy_map" /> -->
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/mapping_param.yaml" ns="/dynamic_map" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/dynamic_navigation/dynamic_detector_param.yaml" ns="/xgc2_cerlab_onboard_detector" />

	<node pkg="xgc2_cerlab_autonomous_flight" type="dynamic_navigation_node" name="dynamic_navigation_node" output="screen" />
</launch>