<launch>
	<rosparam file="$(find xgc2_cerlab_tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />
	<!-- <node pkg="xgc2_cerlab_tracking_controller" type="tracking_controller_node" name="tracking_controller_node" /> -->


	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/navigation/flight_base.yaml" ns="xgc2_cerlab_autonomous_flight"/>
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/navigation/planner_param.yaml" />
	<rosparam file="$(find xgc2_cerlab_autonomous_flight)/cfg/navigation/mapping_param.yaml" ns="/occupancy_map" />
	<node pkg="xgc2_cerlab_autonomous_flight" type="navigation_node" name="navigation_node" output="screen" />
</launch>