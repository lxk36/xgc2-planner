<?xml version="1.0"?>
<package format="2">
  <name>gcopter</name>
  <version>0.1.0</version>
  <description>GCOPTER global multicopter trajectory optimizer for ROS1.</description>

  <author email="wangzhepei@live.com">Zhepei Wang</author>
  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libompl-dev</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libompl15</exec_depend>
  <exec_depend>mockamap</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
</package>
